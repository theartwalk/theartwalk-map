# ID of the Google Sheet that holds the master data (the long string in the sheet's URL).
# The sheet must be shared as "Anyone with the link: Viewer".
# Leave empty to run on the built-in sample data.
SHEET_ID=

# The public address of the site, used in WhatsApp share links.
NEXT_PUBLIC_SITE_URL=https://theartwalk.in

# The Art Walk WhatsApp community invite link, shown in the profile.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# WhatsApp number (country code, no +) that receives gallery submissions.
NEXT_PUBLIC_SUBMIT_WHATSAPP=919654256673
